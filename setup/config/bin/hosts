#!/usr/bin/env python3
"""Single source of truth for the machines you work on.

Reads setup/config/ssh/hosts.toml and either resolves an alias (used by `conn`)
or generates the SSH config. Port forwards follow one formula, so a new machine
or service never needs hand-picked ports:

    remote port = service_prefix * 1000 + user_id * 10 + slot
    local port  = service_prefix * 1000 + machine_id * 10 + slot

The local side varies by machine and the remote side by user, so the same
service on several machines lands on distinct local ports, and several people
on one shared machine do not collide.

    hosts resolve <alias>            # -> name, hostname, mosh port range
    hosts identity                   # -> the default identity_file
    hosts git-remotes                # -> `<remote> <ssh-host>` per machine
    hosts ssh-config --base          # -> ~/.ssh/config           (full mode)
    hosts ssh-config --fragment      # -> ~/.ssh/config.d/<suffix>-hosts (layer)
    hosts ssh-config --forwards      # -> ~/.ssh/config.d/generated-port-forwards
    hosts list
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:  # tomllib landed in 3.11; macOS still ships 3.9.
    sys.exit(
        f"{sys.executable} is {sys.version_info.major}.{sys.version_info.minor}; "
        "this needs 3.11+ for tomllib. Run setup/install.sh --only packages, "
        "or put a newer python3 first on PATH."
    )


def hosts_file() -> Path:
    if env := os.environ.get("DEV_HOSTS_FILE"):
        return Path(env)
    if setup_dir := os.environ.get("DEV_SETUP_DIR"):
        return Path(setup_dir) / "config" / "ssh" / "hosts.toml"
    # bin/ is symlinked into ~/.config/bin, so resolve through the symlink.
    return Path(__file__).resolve().parent.parent / "ssh" / "hosts.toml"


def load() -> dict:
    path = hosts_file()
    if not path.is_file():
        sys.exit(f"No hosts file at {path} (copy hosts.toml.example).")
    with path.open("rb") as handle:
        return tomllib.load(handle)


def machines(config: dict) -> list[dict]:
    return config.get("machines", [])


def find(config: dict, wanted: str) -> dict | None:
    for machine in machines(config):
        if wanted == machine["name"] or wanted in machine.get("aliases", []):
            return machine
    return None


def cmd_resolve(config: dict, args: argparse.Namespace) -> None:
    machine = find(config, args.alias)
    if machine is None:
        # Unknown names pass through untouched: `conn some-other-box` still works.
        print(f"name={args.alias}\nhostname={args.alias}\nmosh_ports=")
        return
    print(f"name={machine['name']}")
    print(f"hostname={machine.get('hostname') or machine['name']}")
    print(f"mosh_ports={machine.get('mosh_ports', '')}")


def cmd_list(config: dict, _: argparse.Namespace) -> None:
    for machine in machines(config):
        aliases = ", ".join(machine.get("aliases", [])) or "-"
        print(f"{machine['name']:<20} id={machine['id']:<3} aliases: {aliases}")


def short_name(machine: dict) -> str:
    """The name you type: the first alias, or the machine name when it has none.
    `conn <x>` and `git pull <x> master` should agree on what `<x>` is."""
    aliases = machine.get("aliases", [])
    return aliases[0] if aliases else machine["name"]


def cmd_git_remotes(config: dict, _: argparse.Namespace) -> None:
    """One `<remote> <ssh-host>` pair per machine, for adding each machine's clone
    of a repo as a git remote. The remote is the short name; the ssh host is the
    machine name, which the generated SSH config always carries."""
    for machine in machines(config):
        print(f"{short_name(machine)} {machine['name']}")


def host_patterns(machine: dict, *, fwd_only: bool = False) -> str:
    names = [machine["name"], *machine.get("aliases", [])]
    patterns = [f"{name}-fwd" for name in names]
    if not fwd_only:
        patterns = names + patterns
    return " ".join(patterns)


def generate_base(config: dict, fragment: bool = False) -> str:
    """Full ~/.ssh/config, or (fragment=True) a drop-in for ~/.ssh/config.d/.

    The fragment form exists for layer mode, where another setup owns
    ~/.ssh/config. It emits the machine blocks and nothing global: no Include
    (the base config already has one, and a self-Include would recurse) and no
    `Host *` (that block is the owning setup's to define -- ssh takes the first
    value it sees for an option, so a second `Host *` silently wins or loses
    depending on include order, which is not a thing to leave to chance).

    The agent options therefore move *into* each machine block, and
    IgnoreUnknown is emitted at the fragment's own file scope, which is where it
    has to be: inside a Host block it is only applied when that block matches,
    while the unknown keyword is still rejected when it does not -- so a
    per-host placement makes non-Apple ssh refuse the entire file for every
    other host.
    """
    defaults = config.get("defaults", {})
    # AddKeysToAgent/UseKeychain are the declarative form of `ssh-add
    # --apple-use-keychain`: the first connection loads the key into the agent,
    # and on macOS its passphrase comes from the login keychain rather than a
    # prompt. They belong here rather than in an install step because `ssh-add`
    # mutates agent state, which cannot converge and does not survive a logout.
    #
    # IgnoreUnknown is load-bearing, not defensive. UseKeychain is Apple's ssh
    # only; plain OpenSSH treats it as a *fatal* config error ("terminating, 1
    # bad configuration options") and refuses the entire file, so an unguarded
    # line would break every ssh on the Linux machines this same config reaches.
    #
    # It is emitted at file scope, above `Host *`, and that placement is not
    # cosmetic: inside a Host block IgnoreUnknown is only applied when the block
    # matches, while the unknown keyword is still rejected when it does not.
    # Put it under a specific host and ssh refuses the file for every *other*
    # host -- which `ssh -G <that host>` cannot reveal, because it is the one
    # name that works. Verify with a host the block does not match.
    lines = [
        "# Generated by setup/config/bin/hosts — edit hosts.toml, not this file.",
        "Include ~/.ssh/config.d/*",
        "",
        "IgnoreUnknown UseKeychain",
        "",
        "Host *",
        "    ServerAliveInterval 60",
        "    ServerAliveCountMax 3",
        "    AddKeysToAgent yes",
        "    UseKeychain yes",
        "",
    ]
    if fragment:
        lines = [
            "# Generated by setup/config/bin/hosts — edit hosts.toml, not this file.",
            "# Layer-mode drop-in: another setup owns ~/.ssh/config.",
            "",
            "IgnoreUnknown UseKeychain",
            "",
        ]
    # git forges get the same treatment as a machine block, and for the same
    # reason spelled out below: a key that is not one of ssh's default
    # filenames is never offered by plain `git fetch` over ssh, which dies with
    # a bare "Permission denied (publickey)" for a key that authenticates fine
    # under `ssh -i`. Every `git@github.com:` remote on a fresh box hits this,
    # and nothing in the error names the cause. IdentitiesOnly keeps the pin
    # deterministic once a second key exists.
    #
    # Opt out or extend per machine with `git_hosts` in [defaults]; an empty
    # list emits nothing, for an instantiation whose forge pin belongs to
    # somebody else.
    if identity := defaults.get("identity_file"):
        for forge in defaults.get("git_hosts", ["github.com"]):
            lines.append(f"Host {forge}")
            lines.append(f"    IdentityFile {identity}")
            lines.append("    IdentitiesOnly yes")
            lines.append("")

    for machine in machines(config):
        lines.append(f"Host {host_patterns(machine)}")
        lines.append(f"    HostName {machine.get('hostname') or machine['name']}")
        if user := machine.get("user", defaults.get("user")):
            lines.append(f"    User {user}")
        if jump := machine.get("jump_host", defaults.get("jump_host")):
            lines.append(f"    ProxyJump {jump}")
        if port := machine.get("port", defaults.get("port")):
            lines.append(f"    Port {port}")
        # Naming the key matters whenever it is not one of ssh's default
        # filenames (id_ed25519, id_rsa, ...): git and anything else that shells
        # out to plain ssh never offers it, and the failure is an
        # undiagnosable "Permission denied (publickey)" for a key that works
        # perfectly under `ssh -i`.
        if identity := machine.get("identity_file", defaults.get("identity_file")):
            lines.append(f"    IdentityFile {identity}")
        lines.append("    ForwardAgent yes")
        if fragment:
            lines.append("    ServerAliveInterval 60")
            lines.append("    ServerAliveCountMax 3")
            lines.append("    AddKeysToAgent yes")
            lines.append("    UseKeychain yes")
        lines.append("")
    return "\n".join(lines)


def generate_forwards(config: dict) -> str:
    defaults = config.get("defaults", {})
    services = config.get("services", {})
    slots = int(defaults.get("slots", 4))
    user_id = int(defaults.get("user_id", 0))
    clipboard = config.get("clipboard", {})

    lines = [
        "# Generated by setup/config/bin/hosts — edit hosts.toml, not this file.",
        "#   remote = prefix*1000 + user_id*10 + slot",
        "#   local  = prefix*1000 + machine_id*10 + slot",
        "",
    ]
    for machine in machines(config):
        machine_id = int(machine["id"])
        lines.append(f"Host {host_patterns(machine, fwd_only=True)}")
        if clipboard:
            lines.append(
                f"    RemoteForward {clipboard['remote_port']} "
                f"127.0.0.1:{clipboard['local_port']}  # clipboard (lemonade)"
            )
        for slot in range(slots):
            for service, prefix in services.items():
                remote = prefix * 1000 + user_id * 10 + slot
                local = prefix * 1000 + machine_id * 10 + slot
                lines.append(
                    f"    LocalForward {local} localhost:{remote}  # {service} slot {slot}"
                )
        lines.append("")
    return "\n".join(lines)


def cmd_identity(config: dict, _: argparse.Namespace) -> None:
    """The default identity file, so install steps can check it exists without
    re-parsing hosts.toml in shell. Prints nothing when none is configured."""
    if identity := config.get("defaults", {}).get("identity_file"):
        print(identity)


def cmd_ssh_config(config: dict, args: argparse.Namespace) -> None:
    if args.forwards:
        print(generate_forwards(config))
    else:
        print(generate_base(config, fragment=args.fragment))


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    resolve = sub.add_parser("resolve", help="print name/hostname/mosh_ports for an alias")
    resolve.add_argument("alias")
    resolve.set_defaults(func=cmd_resolve)

    listing = sub.add_parser("list", help="list configured machines")
    listing.set_defaults(func=cmd_list)

    identity = sub.add_parser("identity", help="print the default identity_file")
    identity.set_defaults(func=cmd_identity)

    remotes = sub.add_parser("git-remotes", help="print `<remote> <ssh-host>` per machine")
    remotes.set_defaults(func=cmd_git_remotes)

    ssh_config = sub.add_parser("ssh-config", help="generate SSH config")
    group = ssh_config.add_mutually_exclusive_group(required=True)
    group.add_argument("--base", action="store_true", help="whole ~/.ssh/config (full mode)")
    group.add_argument(
        "--fragment", action="store_true", help="drop-in for ~/.ssh/config.d/ (layer mode)"
    )
    group.add_argument("--forwards", action="store_true")
    ssh_config.set_defaults(func=cmd_ssh_config)

    args = parser.parse_args()
    args.func(load(), args)


if __name__ == "__main__":
    main()
