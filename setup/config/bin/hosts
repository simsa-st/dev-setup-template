#!/usr/bin/env python3
"""Single source of truth for the machines you work on.

Reads setup/config/ssh/hosts.toml and either resolves an alias (used by `conn`)
or generates the SSH config. Port forwards follow one formula, so a new machine
or service never needs hand-picked ports:

    remote port = service_prefix * 1000 + user_id * 10 + slot
    local port  = service_prefix * 1000 + machine_id * 10 + slot

The local side varies by machine and the remote side by user, so the same
service on several machines lands on distinct local ports, and several people
on one shared machine do not collide.

    hosts resolve <alias>            # -> name, hostname, mosh port range
    hosts ssh-config --base          # -> ~/.ssh/config
    hosts ssh-config --forwards      # -> ~/.ssh/config.d/generated-port-forwards
    hosts list
"""

from __future__ import annotations

import argparse
import os
import sys
import tomllib
from pathlib import Path


def hosts_file() -> Path:
    if env := os.environ.get("DEV_HOSTS_FILE"):
        return Path(env)
    if setup_dir := os.environ.get("DEV_SETUP_DIR"):
        return Path(setup_dir) / "config" / "ssh" / "hosts.toml"
    # bin/ is symlinked into ~/.config/bin, so resolve through the symlink.
    return Path(__file__).resolve().parent.parent / "ssh" / "hosts.toml"


def load() -> dict:
    path = hosts_file()
    if not path.is_file():
        sys.exit(f"No hosts file at {path} (copy hosts.toml.example).")
    with path.open("rb") as handle:
        return tomllib.load(handle)


def machines(config: dict) -> list[dict]:
    return config.get("machines", [])


def find(config: dict, wanted: str) -> dict | None:
    for machine in machines(config):
        if wanted == machine["name"] or wanted in machine.get("aliases", []):
            return machine
    return None


def cmd_resolve(config: dict, args: argparse.Namespace) -> None:
    machine = find(config, args.alias)
    if machine is None:
        # Unknown names pass through untouched: `conn some-other-box` still works.
        print(f"name={args.alias}\nhostname={args.alias}\nmosh_ports=")
        return
    print(f"name={machine['name']}")
    print(f"hostname={machine.get('hostname') or machine['name']}")
    print(f"mosh_ports={machine.get('mosh_ports', '')}")


def cmd_list(config: dict, _: argparse.Namespace) -> None:
    for machine in machines(config):
        aliases = ", ".join(machine.get("aliases", [])) or "-"
        print(f"{machine['name']:<20} id={machine['id']:<3} aliases: {aliases}")


def host_patterns(machine: dict, *, fwd_only: bool = False) -> str:
    names = [machine["name"], *machine.get("aliases", [])]
    patterns = [f"{name}-fwd" for name in names]
    if not fwd_only:
        patterns = names + patterns
    return " ".join(patterns)


def generate_base(config: dict) -> str:
    defaults = config.get("defaults", {})
    lines = [
        "# Generated by setup/config/bin/hosts — edit hosts.toml, not this file.",
        "Include ~/.ssh/config.d/*",
        "",
        "Host *",
        "    ServerAliveInterval 60",
        "    ServerAliveCountMax 3",
        "",
    ]
    for machine in machines(config):
        lines.append(f"Host {host_patterns(machine)}")
        lines.append(f"    HostName {machine.get('hostname') or machine['name']}")
        if user := machine.get("user", defaults.get("user")):
            lines.append(f"    User {user}")
        if jump := machine.get("jump_host", defaults.get("jump_host")):
            lines.append(f"    ProxyJump {jump}")
        if port := machine.get("port", defaults.get("port")):
            lines.append(f"    Port {port}")
        lines.append("    ForwardAgent yes")
        lines.append("")
    return "\n".join(lines)


def generate_forwards(config: dict) -> str:
    defaults = config.get("defaults", {})
    services = config.get("services", {})
    slots = int(defaults.get("slots", 4))
    user_id = int(defaults.get("user_id", 0))
    clipboard = config.get("clipboard", {})

    lines = [
        "# Generated by setup/config/bin/hosts — edit hosts.toml, not this file.",
        "#   remote = prefix*1000 + user_id*10 + slot",
        "#   local  = prefix*1000 + machine_id*10 + slot",
        "",
    ]
    for machine in machines(config):
        machine_id = int(machine["id"])
        lines.append(f"Host {host_patterns(machine, fwd_only=True)}")
        if clipboard:
            lines.append(
                f"    RemoteForward {clipboard['remote_port']} "
                f"127.0.0.1:{clipboard['local_port']}  # clipboard (lemonade)"
            )
        for slot in range(slots):
            for service, prefix in services.items():
                remote = prefix * 1000 + user_id * 10 + slot
                local = prefix * 1000 + machine_id * 10 + slot
                lines.append(f"    LocalForward {local} localhost:{remote}  # {service} slot {slot}")
        lines.append("")
    return "\n".join(lines)


def cmd_ssh_config(config: dict, args: argparse.Namespace) -> None:
    print(generate_forwards(config) if args.forwards else generate_base(config))


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    resolve = sub.add_parser("resolve", help="print name/hostname/mosh_ports for an alias")
    resolve.add_argument("alias")
    resolve.set_defaults(func=cmd_resolve)

    listing = sub.add_parser("list", help="list configured machines")
    listing.set_defaults(func=cmd_list)

    ssh_config = sub.add_parser("ssh-config", help="generate SSH config")
    group = ssh_config.add_mutually_exclusive_group(required=True)
    group.add_argument("--base", action="store_true")
    group.add_argument("--forwards", action="store_true")
    ssh_config.set_defaults(func=cmd_ssh_config)

    args = parser.parse_args()
    args.func(load(), args)


if __name__ == "__main__":
    main()
