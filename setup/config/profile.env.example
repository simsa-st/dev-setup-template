# Copy to profile.env and commit it — these values are shared by all your
# machines. Anything that differs per machine goes in machine.local.env
# (gitignored); anything secret goes in secrets/env (gitignored).

# --- modes and coexistence -----------------------------------------------
# These three only matter in layer mode, where another setup owns the base of
# the machine — but set them anyway: a machine can be switched to layer later,
# and the values must be stable when it is.
#
# TODO(bootstrap): the tree this setup's work lives in. Entering it is what
# switches neovim and the coding agents over to this setup's configs, via an
# .envrc the env step writes. Leave empty if this instantiation will never
# share a machine with another one.
LAYER_ROOT="${HOME}/TODO-tree"

# TODO(bootstrap): names every path installed beside another setup's —
# ~/.claude-<suffix>, ~/.config/nvim-<suffix>, ~/.config/.bashrc-<suffix>, the
# ssh fragment, and the short aliases in shell/bashrc-layer. Two instantiations
# sharing a machine must not share this — and note the layer paths are created
# in *both* modes, so a full-mode instantiation still needs its own suffix.
LAYER_SUFFIX="TODO-suffix"

# TODO(bootstrap): namespace for the BEGIN/END blocks this repo writes into
# files it does not own (~/.zshrc, ~/.ssh/config). Two instantiations sharing a
# machine must not share this either, or each install silently overwrites the
# other's block.
MANAGED_BLOCK_PREFIX="DEVSETUP_TODO"

# --- optional activity breadcrumbs --------------------------------------
# Explicit category only; never infer personal/work from the repository.
# Set to work or personal to have agents log a short anchor per human prompt.
# An instantiation sharing a machine must keep its activity state and vault
# destination separate from the owning setup's. See docs/activity-log.md.
ACTIVITY_LOG_CATEGORY=""

# --- identity ------------------------------------------------------------
GIT_USER_NAME="TODO Your Name"
GIT_USER_EMAIL="TODO you@example.com"

# --- editor --------------------------------------------------------------
# Neovim config lives in its own repo so it versions independently of setup.
#
# There is ONE nvim config -- yours -- and every instantiation (the personal
# one, each job's) clones the same repo. The editor is personal, so nothing
# employer-specific is committed there; the rule lives in each work repo's
# agent instructions. Anonymous HTTPS, not ssh: a machine whose github.com is
# pinned to another account's key (a work box) must still be able to pull.
NVIM_CONFIG_REPO="TODO https://github.com/you/nvim-config.git"
# The identity a commit in that clone carries. Set it where GIT_USER_EMAIL is
# not the account the nvim repo belongs to (a work instantiation); empty
# inherits the global identity.
NVIM_CONFIG_GIT_EMAIL=""
# Where a push goes, when github.com itself resolves to the wrong key. Name an
# ssh alias from ~/.ssh/config.d/ that carries the right one
# (git@<alias>:you/nvim-config.git); step_nvim sets it as the remote's *push*
# URL wherever `ssh -G <alias>` resolves to github.com and leaves fetching on
# the URL above -- so a box without the key still pulls, and the laptop pushes.
# Empty when the default key already has access. See setup/README.md.
NVIM_CONFIG_PUSH_URL=""
NVIM_APPNAME="nvim"
NVIM_VERSION="stable"

# --- pinned tool versions ------------------------------------------------
MIN_UV_VERSION="0.8.22"
NVM_VERSION="v0.40.4"
DELTA_VERSION="0.18.2"
JQ_VERSION="1.8.1"
LEMONADE_VERSION="v1.1.1"
BOB_VERSION="v4.1.7"
# nvim-treesitter (main) compiles parsers through this CLI; it wants >= 0.26.1.
TREE_SITTER_CLI_VERSION="v0.27.0"
# Append @<version> to pin it; unpinned installs whatever npm publishes today.
PI_PACKAGE="@earendil-works/pi-coding-agent"

# --- clipboard ports -----------------------------------------------------
# laptop lemonade server <- reverse SSH tunnel <- relay on the remote host
LEMONADE_LOCAL_PORT=2489
LEMONADE_TUNNEL_PORT=64010
LEMONADE_RELAY_PORT=64011
# The relay's bind address. It has to be reachable from containers and other
# namespaces on the host, which is why it is not loopback -- but it speaks to
# the tunnel with no authentication of its own, so anyone who can reach this
# address and port can read and write the clipboard at the far end. On a host
# with untrusted tenants, bind it to an interface only you can reach and change
# the ports from the published defaults.
LEMONADE_RELAY_BIND=0.0.0.0

# --- tmux ----------------------------------------------------------------
# A private socket keeps these sessions apart from anything else on the host.
TMUX_SOCKET="${HOME}/tmp-tmux-socket"

# How often the layout and the agent name map are saved, in seconds. This is
# the worst-case loss on an unplanned reboot (setup/lib/sessions.sh).
TMUX_PERSIST_INTERVAL=120
TMUX_PERSIST_LABEL="dev.setup.tmux-persist"
