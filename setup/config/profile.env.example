# Copy to profile.env and commit it — these values are shared by all your
# machines. Anything that differs per machine goes in machine.local.env
# (gitignored); anything secret goes in secrets/env (gitignored).

# --- identity ------------------------------------------------------------
GIT_USER_NAME="TODO Your Name"
GIT_USER_EMAIL="TODO you@example.com"

# --- editor --------------------------------------------------------------
# Neovim config lives in its own repo so it versions independently of setup.
NVIM_CONFIG_REPO="TODO git@github.com:you/nvim-config.git"
NVIM_APPNAME="nvim"
NVIM_VERSION="stable"

# --- pinned tool versions ------------------------------------------------
MIN_UV_VERSION="0.8.22"
NVM_VERSION="v0.40.4"
DELTA_VERSION="0.18.2"
LEMONADE_VERSION="v1.1.1"
PI_PACKAGE="@earendil-works/pi-coding-agent"

# --- clipboard ports -----------------------------------------------------
# laptop lemonade server <- reverse SSH tunnel <- relay on the remote host
LEMONADE_LOCAL_PORT=2489
LEMONADE_TUNNEL_PORT=64010
LEMONADE_RELAY_PORT=64011

# --- tmux ----------------------------------------------------------------
# A private socket keeps these sessions apart from anything else on the host.
TMUX_SOCKET="${HOME}/tmp-tmux-socket"
