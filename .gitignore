# --- experiment outputs (never commit; see experiments/README.md) ---
data/
screen_logs/
reports/
profiles/
*.ipynb_checkpoints/

# --- machine-specific setup state (profile.env and hosts.toml ARE committed) ---
setup/config/machine.local.env

# --- secrets: nothing in here is committed except the docs and examples ---
setup/config/secrets/*
!setup/config/secrets/README.md
!setup/config/secrets/*.example

# --- python ---
__pycache__/
*.py[cod]
.venv/
.ruff_cache/

# --- editors / os ---
.DS_Store
*.swp
